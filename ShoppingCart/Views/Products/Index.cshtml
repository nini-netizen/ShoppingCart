@model List<ShoppingCart.Models.Product>

<h2>Products</h2>

<p>
    <a class="btn btn-success" asp-action="Create">Create New</a>
</p>

<table class="table">
    <thead>
        <tr>
            <th>ID</th>
            <th>Name</th>
            <th>Price</th>
            <th>Stock</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var p in Model)
        {
            <tr>
                <td>@p.ProductId</td>
                <td>@p.Name</td>
                <td>@p.Price</td>
                <td>@p.Stock</td>
                <td>
                    <a class="btn btn-sm btn-primary"
                       asp-action="Edit"
                       asp-route-id="@p.ProductId">Edit</a>

                    <a class="btn btn-sm btn-danger"
                       asp-action="Delete"
                       asp-route-id="@p.ProductId">Delete</a>

                    <form asp-controller="Cart"
                          asp-action="Add"
                          method="post"
                          style="display:inline;">
                        @Html.AntiForgeryToken()
                        <input type="hidden"
                               name="productId"
                               value="@p.ProductId" />
                        <button class="btn btn-sm btn-success"
                                type="submit">
                            Add to Cart
                        </button>
                    </form>
                </td>
            </tr>
        }
    </tbody>
</table>
